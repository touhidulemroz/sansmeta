# Base URL for SansMeta FastAPI backend (for split Static Site + Web Service deployment).
# When empty or omitted, requests use relative /api paths (ideal for local dev or combined service).
# Example for Render production:
# VITE_API_BASE_URL=https://sansmeta-api.onrender.com
VITE_API_BASE_URL=

# Lemon Squeezy checkout link for SansMeta for Mac desktop license
# Example: https://sansmeta.lemonsqueezy.com/buy/your-product-id
VITE_MAC_APP_CHECKOUT_URL=https://sansmeta.lemonsqueezy.com/buy/desktop
