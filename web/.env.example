# Temporary-file fallback expiry in seconds. The backend constrains this to
# 1–900 seconds so the privacy fallback never exceeds 15 minutes.
WEB_JOB_TTL_SECONDS=900

# Optional upload/text limits.
WEB_MAX_FILE_BYTES=268435456
WEB_MAX_TEXT_BYTES=8388608

# Optional public origin for canonical URLs and sitemap generation.
# WEB_PUBLIC_ORIGIN=https://example.com

# Optional allowed CORS origins for split deployment (comma-separated).
# Defaults to wildcard (*) if unset or empty, allowing any origin.
# WEB_CORS_ORIGINS=https://sansmeta-web.onrender.com,https://sansmeta.com

# Optional deployment-wide API key. Never expose this through /api/config.
# WEB_API_KEY=replace-with-a-secret
